<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_rate_report_tree" model="ir.ui.view">
        <field name="name">sql.rental.rate.report.tree</field>
        <field name="model">sql.rental.rate.report</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="date"/>
                <field name="contract_order_number"/>
                <field name="bin_volume_type"/>
                <field name="rental_rate" sum="Total Rate"/>
                <field name="discount_rate"/>
                <field name="escalation_rate"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_rate_report_form" model="ir.ui.view">
        <field name="name">sql.rental.rate.report.form</field>
        <field name="model">sql.rental.rate.report</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="contract_order_number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Info">
                            <field name="date"/>
                            <field name="bin_volume_type"/>
                            <field name="rental_rate"/>
                        </group>
                        <group string="Date Parts">
                            <field name="year"/>
                            <field name="month"/>
                            <field name="weeks"/>
                            <field name="day"/>
                        </group>
                        <group string="Rates">
                            <field name="discount_rate"/>
                            <field name="escalation_rate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_rate_report_search" model="ir.ui.view">
        <field name="name">sql.rental.rate.report.search</field>
        <field name="model">sql.rental.rate.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="contract_order_number"/>
                <field name="bin_volume_type"/>
                <group expand="1" string="Group By">
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Week" name="group_week" context="{'group_by': 'weeks'}"/>
                    <filter string="Bin Type" name="group_bin_type" context="{'group_by': 'bin_volume_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_rate_report" model="ir.actions.act_window">
        <field name="name">Rental Rates</field>
        <field name="res_model">sql.rental.rate.report</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_rental_rate_report_tree"/>
    </record>

    <menuitem 
        id="menu_rental_rate_report"
        name="Rental Rates"
        parent="menu_sql_data"
        action="action_rental_rate_report"
        sequence="110"/>
</odoo> 