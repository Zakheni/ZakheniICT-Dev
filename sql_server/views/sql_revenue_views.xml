<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_revenue_analysis_tree" model="ir.ui.view">
        <field name="name">sql.revenue.analysis.tree</field>
        <field name="model">sql.revenue.analysis</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="invoice_created_date"/>
                <field name="invoice_number"/>
                <field name="customer_name"/>
                <field name="mine_name"/>
                <field name="exclusive_total_amount" sum="Total Excl."/>
                <field name="inclusive_total_amount" sum="Total Incl."/>
                <field name="waste_description"/>
                <field name="service_offering_type"/>
            </tree>
        </field>
    </record>

    <record id="view_revenue_analysis_form" model="ir.ui.view">
        <field name="name">sql.revenue.analysis.form</field>
        <field name="model">sql.revenue.analysis</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group>
                            <field name="invoice_created_date"/>
                            <field name="invoice_number"/>
                            <field name="customer_name"/>
                            <field name="mine_name"/>
                        </group>
                        <group>
                            <field name="exclusive_total_amount"/>
                            <field name="inclusive_total_amount"/>
                            <field name="waste_description"/>
                            <field name="service_offering_type"/>
                        </group>
                        <group string="Date Parts">
                            <field name="invoice_year"/>
                            <field name="invoice_month"/>
                            <field name="invoice_day"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_revenue_analysis_search" model="ir.ui.view">
        <field name="name">sql.revenue.analysis.search</field>
        <field name="model">sql.revenue.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name"/>
                <field name="mine_name"/>
                <field name="invoice_number"/>
                <field name="waste_description"/>
                <field name="service_offering_type"/>
                <group expand="1" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_name'}"/>
                    <filter string="Mine" name="group_mine" context="{'group_by': 'mine_name'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'invoice_year'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'invoice_month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_revenue_analysis" model="ir.actions.act_window">
        <field name="name">Revenue Analysis</field>
        <field name="res_model">sql.revenue.analysis</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_revenue_analysis_tree"/>
    </record>

    <menuitem 
        id="menu_revenue_analysis"
        name="Revenue Analysis"
        parent="menu_sql_data"
        action="action_revenue_analysis"
        sequence="20"/>
</odoo> 