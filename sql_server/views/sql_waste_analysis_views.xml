<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_waste_analysis_tree" model="ir.ui.view">
        <field name="name">sql.waste.analysis.tree</field>
        <field name="model">sql.waste.analysis</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="date_of_service_request"/>
                <field name="manifest_number"/>
                <field name="customer_name"/>
                <field name="mine_name"/>
                <field name="waste_description"/>
                <field name="service_offering_type"/>
                <field name="site_name"/>
                <field name="tonnage" sum="Total Tonnage"/>
            </tree>
        </field>
    </record>

    <record id="view_waste_analysis_form" model="ir.ui.view">
        <field name="name">sql.waste.analysis.form</field>
        <field name="model">sql.waste.analysis</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="manifest_number"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer Information">
                            <field name="customer_name"/>
                            <field name="mine_name"/>
                            <field name="date_of_service_request"/>
                        </group>
                        <group string="Service Details">
                            <field name="waste_description"/>
                            <field name="service_offering_type"/>
                            <field name="site_name"/>
                            <field name="tonnage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_waste_analysis_search" model="ir.ui.view">
        <field name="name">sql.waste.analysis.search</field>
        <field name="model">sql.waste.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="manifest_number"/>
                <field name="customer_name"/>
                <field name="mine_name"/>
                <field name="waste_description"/>
                <field name="service_offering_type"/>
                <field name="site_name"/>
                <group expand="1" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_name'}"/>
                    <filter string="Mine" name="group_mine" context="{'group_by': 'mine_name'}"/>
                    <filter string="Waste Type" name="group_waste" context="{'group_by': 'waste_description'}"/>
                    <filter string="Service Type" name="group_service" context="{'group_by': 'service_offering_type'}"/>
                    <filter string="Site" name="group_site" context="{'group_by': 'site_name'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date_of_service_request:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_waste_analysis" model="ir.actions.act_window">
        <field name="name">Waste Analysis</field>
        <field name="res_model">sql.waste.analysis</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_waste_analysis_tree"/>
    </record>

    <menuitem 
        id="menu_waste_analysis"
        name="Waste Analysis"
        parent="menu_sql_data"
        action="action_waste_analysis"
        sequence="70"/>
</odoo> 