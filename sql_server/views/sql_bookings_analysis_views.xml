<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bookings_analysis_tree" model="ir.ui.view">
        <field name="name">sql.bookings.analysis.tree</field>
        <field name="model">sql.bookings.analysis</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="date_received"/>
                <field name="bin_id"/>
                <field name="customer_name"/>
                <field name="mine_name"/>
                <field name="waste_description"/>
                <field name="service_offering_type"/>
            </tree>
        </field>
    </record>

    <record id="view_bookings_analysis_form" model="ir.ui.view">
        <field name="name">sql.bookings.analysis.form</field>
        <field name="model">sql.bookings.analysis</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="bin_id"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Booking Details">
                            <field name="date_received"/>
                            <field name="customer_name"/>
                            <field name="mine_name"/>
                        </group>
                        <group string="Service Information">
                            <field name="waste_description"/>
                            <field name="service_offering_type"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bookings_analysis_search" model="ir.ui.view">
        <field name="name">sql.bookings.analysis.search</field>
        <field name="model">sql.bookings.analysis</field>
        <field name="arch" type="xml">
            <search>
                <field name="bin_id"/>
                <field name="customer_name"/>
                <field name="mine_name"/>
                <field name="waste_description"/>
                <field name="service_offering_type"/>
                <group expand="1" string="Group By">
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_name'}"/>
                    <filter string="Mine" name="group_mine" context="{'group_by': 'mine_name'}"/>
                    <filter string="Waste Type" name="group_waste" context="{'group_by': 'waste_description'}"/>
                    <filter string="Service Type" name="group_service" context="{'group_by': 'service_offering_type'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date_received:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bookings_analysis" model="ir.actions.act_window">
        <field name="name">Bookings Analysis</field>
        <field name="res_model">sql.bookings.analysis</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_bookings_analysis_tree"/>
    </record>

    <menuitem 
        id="menu_bookings_analysis"
        name="Bookings Analysis"
        parent="menu_sql_data"
        action="action_bookings_analysis"
        sequence="80"/>
</odoo> 